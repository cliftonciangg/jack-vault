# The host (Railway) terminates HTTPS and forwards plain HTTP to $PORT.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	# www.example.com -> example.com
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# owner.* and agent.* show only the back office (the server picks the login for each host).
	@staffsite {
		host {$OWNER_HOST} {$AGENT_HOST}
		not path /api/*
	}
	handle @staffsite {
		rewrite * /office
		reverse_proxy 127.0.0.1:8081
	}

	@server path /api/* /ws /ws/* /office /office/*
	handle @server {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		root * /srv/client
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control no-cache
		header / Cache-Control no-cache
		file_server
	}

	encode zstd gzip
	log {
		output stdout
		format console
		level WARN
	}
}
