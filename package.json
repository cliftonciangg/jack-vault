{
  "name": "jack-vault-server",
  "version": "0.1.0",
  "private": true,
  "description": "Server-authoritative game server for Jack Vault: 5x4, 25-line reels, free spins, Super Wheel and four progressive jackpots.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/api/server.ts",
    "client": "npm --prefix client run dev",
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.json && cp src/store/schema.sql dist/src/store/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:up": "docker compose up -d db",
    "sim": "tsx src/sim/simulate.ts",
    "par": "tsx src/sim/par.ts",
    "tune": "tsx src/sim/tune.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
